{
  "name": "produce-gallery",
  "private": true,
  "version": "0.1.0",
  "description": "A small library of growing things — fruits, vegetables, herbs, spices, nuts, mushrooms, legumes, grains, and seeds. Curated, frozen Wikidata snapshot, or live SPARQL.",
  "license": "UNLICENSED",
  "author": "stalevski",
  "homepage": "https://stalevski.github.io/produce-gallery/",
  "repository": {
    "type": "git",
    "url": "https://github.com/stalevski/produce-gallery.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "snapshot": "node scripts/generate-snapshot.mjs",
    "test:e2e": "playwright test",
    "test:shuffle": "playwright test --shuffle",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16"
  }
}
